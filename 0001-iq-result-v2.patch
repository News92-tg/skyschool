+/* ---------- сравнение с другими ---------- */
+function renderIqCompare(percent) {
+  const row = $('#iqCompareRow'); row.innerHTML = '';
+  const chips = [];
+  if (percent >= 80) chips.push({ cls: 'top', text: Sky.t('iqTopPercent') });
+  const diff = percent - IQ_AVERAGE_PERCENT;
+  let avgText;
+  if (diff > 0) avgText = Sky.t('iqAboveAvg').replace('%1', IQ_AVERAGE_PERCENT).replace('%2', diff);
+  else if (diff < 0) avgText = Sky.t('iqBelowAvg').replace('%1', IQ_AVERAGE_PERCENT).replace('%2', Math.abs(diff));
+  else avgText = Sky.t('iqAtAvg').replace('%1', IQ_AVERAGE_PERCENT);
+  chips.push({ cls: '', text: avgText });
+  chips.forEach(c => {
+    const span = document.createElement('span');
+    span.className = 'iq-compare-chip' + (c.cls ? ' ' + c.cls : '');
+    span.textContent = c.text;
+    row.appendChild(span);
+  });
+}
