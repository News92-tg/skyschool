+function iqRingColor(pct) {
+  return pct >= 80 ? 'var(--ok)' : pct >= 50 ? 'var(--warn)' : 'var(--no)';
+}
+function renderIqRings(percent, byPart) {
+  const svg = $('#iqRingsSvg');
+  svg.innerHTML = '';
+  const NS = 'http://www.w3.org/2000/svg';
+  const CX = 110, CY = 110;
+
+  const values = {
+    outer: percent,
+    easy: Sky.pct(byPart.easy.correct, byPart.easy.total),
+    medium: Sky.pct(byPart.medium.correct, byPart.medium.total),
+    hard: Sky.pct(byPart.hard.correct, byPart.hard.total)
+  };
+  const colors = {
+    outer: 'var(--m-learn)',
+    easy: iqRingColor(values.easy),
+    medium: iqRingColor(values.medium),
+    hard: iqRingColor(values.hard)
+  };
+
+  const items = [];
+  IQ_RING_DEFS.forEach(def => {
+    const c = 2 * Math.PI * def.r;
+    const track = document.createElementNS(NS, 'circle');
+    track.setAttribute('class', 'iq-ring-track');
+    track.setAttribute('cx', CX); track.setAttribute('cy', CY); track.setAttribute('r', def.r);
+    track.setAttribute('stroke-width', def.w);
+    svg.appendChild(track);
+
+    const prog = document.createElementNS(NS, 'circle');
+    prog.setAttribute('class', 'iq-ring-progress');
+    prog.setAttribute('cx', CX); prog.setAttribute('cy', CY); prog.setAttribute('r', def.r);
+    prog.setAttribute('stroke-width', def.w);
+    prog.setAttribute('stroke', colors[def.key]);
+    prog.setAttribute('stroke-dasharray', c.toFixed(2));
+    prog.setAttribute('stroke-dashoffset', c.toFixed(2));
+    svg.appendChild(prog);
+    items.push({ el: prog, c, v: values[def.key] });
+  });
+
+  $('#iqRingsPercent').textContent = percent + '%';
+
+  const legend = $('#iqPartsGrid'); legend.innerHTML = '';
