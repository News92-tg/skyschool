+
+  const linePath = document.createElementNS(NS, 'path');
+  linePath.setAttribute('class', 'iq-history-line'); linePath.setAttribute('d', line);
+  svg.appendChild(linePath);
+
+  pts.forEach((p, i) => {
+    const last = i === pts.length - 1;
+    const dot = document.createElementNS(NS, 'circle');
+    dot.setAttribute('class', 'iq-history-dot' + (last ? ' last' : ''));
+    dot.setAttribute('cx', p.x.toFixed(1)); dot.setAttribute('cy', p.y.toFixed(1));
+    dot.setAttribute('r', last ? 4 : 3);
+    svg.appendChild(dot);
+  });
+
+  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && linePath.getTotalLength) {
+    const len = linePath.getTotalLength();
+    linePath.style.strokeDasharray = String(len);
+    linePath.style.strokeDashoffset = String(len);
+    requestAnimationFrame(() => requestAnimationFrame(() => {
+      linePath.style.transition = 'stroke-dashoffset .9s cubic-bezier(.4,0,.2,1)';
+      linePath.style.strokeDashoffset = '0';
+    }));
+  }
+
+  const first = hist[0], last = hist[hist.length - 1], delta = last - first;
+  if (delta > 0) {
+    deltaEl.textContent = Sky.t('iqHistoryUp').replace('%1', delta).replace('%2', hist.length);
+    deltaEl.style.color = 'var(--ok)';
+  } else if (delta < 0) {
+    deltaEl.textContent = Sky.t('iqHistoryDown').replace('%1', Math.abs(delta));
+    deltaEl.style.color = 'var(--no)';
+  } else {
+    deltaEl.textContent = Sky.t('iqHistoryFlat');
+    deltaEl.style.color = '';
+  }
+}
+
+/* ---------- рекомендации от AI-учителя ---------- */
+function pickIqAdvice(byPart) {
+  const hardPct = Sky.pct(byPart.hard.correct, byPart.hard.total);
+  const mediumPct = Sky.pct(byPart.medium.correct, byPart.medium.total);
+  if (hardPct < 60) return 'iqAdviceHard';
+  if (mediumPct < 60) return 'iqAdviceMedium';
+  return 'iqAdviceGood';
+}
+function renderIqAdvice(byPart) {
+  $('#iqAdviceText').textContent = Sky.t(pickIqAdvice(byPart));
+}
+
+/* ---------- «Поделиться результатом»: карточка 1080×1080 + модалка ---------- */
+function iqShareText(result) {
+  const levelLabel = Sky.t('iqLevel' + result.level[0].toUpperCase() + result.level.slice(1)).toLowerCase();
+  return Sky.t('iqShareLine')
+    .replace('%1', result.score).replace('%2', result.maxScore)
+    .replace('%3', result.percent).replace('%4', levelLabel);
+}
+
+function openIqShareModal(result) {
+  const html = `
+    <h2>${Sky.t('iqShareTitle')}</h2>
+    <canvas id="iqShareCanvas" width="1080" height="1080" class="iq-share-canvas"></canvas>
+    <div class="iq-share-actions">
+      <button type="button" class="btn" id="iqShareDownloadBtn">${Sky.t('iqShareDownload')}</button>
+      <button type="button" class="btn tg" id="iqShareTgBtn">Telegram</button>
+      <button type="button" class="btn vk" id="iqShareVkBtn">ВКонтакте</button>
+      <button type="button" class="btn ghost" id="iqShareCopyBtn">${Sky.t('iqShareCopy')}</button>
+    </div>
+    <button type="button" class="btn ghost full hidden" id="iqShareNativeBtn" style="margin-top:9px">${Sky.t('iqShareOther')}</button>
+  `;
+  Sky.modal(html, (root) => {
+    const canvas = root.querySelector('#iqShareCanvas');
+    drawIqShareCard(canvas, result).catch(() => { /* карточка остаётся без QR — см. drawIqQrOrFallback */ });
+
+    root.querySelector('#iqShareDownloadBtn').addEventListener('click', () => downloadIqShareCanvas(canvas, result));
+    root.querySelector('#iqShareTgBtn').addEventListener('click', () => {
+      const url = 'https://t.me/share/url?url=' + encodeURIComponent(IQ_SHARE_URL) + '&text=' + encodeURIComponent(iqShareText(result));
+      window.open(url, '_blank', 'noopener,noreferrer');
+    });
+    root.querySelector('#iqShareVkBtn').addEventListener('click', () => {
+      const url = 'https://vk.com/share.php?url=' + encodeURIComponent(IQ_SHARE_URL) + '&title=' + encodeURIComponent(iqShareText(result));
+      window.open(url, '_blank', 'noopener,noreferrer');
+    });
+    const copyBtn = root.querySelector('#iqShareCopyBtn');
+    copyBtn.addEventListener('click', async () => {
+      const original = copyBtn.textContent;
+      try {
+        await navigator.clipboard.writeText(iqShareText(result));
+        copyBtn.textContent = Sky.t('iqShareCopied');
+      } catch (e) {
+        Sky.toast(iqShareText(result));
+      }
+      setTimeout(() => { copyBtn.textContent = original; }, 1800);
+    });
+
+    const nativeBtn = root.querySelector('#iqShareNativeBtn');
+    if (navigator.share) {
+      nativeBtn.classList.remove('hidden');
+      nativeBtn.addEventListener('click', () => iqNativeShare(canvas, result));
+    }
+  });
+}
+
+function iqRoundRectPath(ctx, x, y, w, h, r) {
+  ctx.beginPath();
+  ctx.moveTo(x + r, y);
+  ctx.arcTo(x + w, y, x + w, y + h, r);
+  ctx.arcTo(x + w, y + h, x, y + h, r);
+  ctx.arcTo(x, y + h, x, y, r);
+  ctx.arcTo(x, y, x + w, y, r);
+  ctx.closePath();
+}
+
+async function drawIqShareCard(canvas, result) {
+  const ctx = canvas.getContext('2d');
+  const W = canvas.width, H = canvas.height;
+
+  const bg = ctx.createLinearGradient(0, 0, W, H);
+  bg.addColorStop(0, '#2f5bea'); bg.addColorStop(1, '#7c3aed');
+  ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
+
+  ctx.save();
+  ctx.globalAlpha = .12; ctx.fillStyle = '#ffffff';
+  ctx.beginPath(); ctx.arc(W * .85, H * .12, 220, 0, Math.PI * 2); ctx.fill();
+  ctx.beginPath(); ctx.arc(W * .08, H * .9, 260, 0, Math.PI * 2); ctx.fill();
+  ctx.restore();
+
+  ctx.textAlign = 'center';
+  ctx.fillStyle = 'rgba(255,255,255,.85)';
+  ctx.font = '600 32px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
+  ctx.fillText(Sky.t('iqShareBrand'), W / 2, 110);
+
+  ctx.fillStyle = '#ffffff';
+  ctx.font = '800 190px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
+  ctx.fillText(`${result.score}/${result.maxScore}`, W / 2, 430);
+
+  ctx.font = '700 64px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
+  ctx.fillStyle = 'rgba(255,255,255,.9)';
+  ctx.fillText(`${result.percent}%`, W / 2, 520);
+
+  const levelLabel = Sky.t('iqLevel' + result.level[0].toUpperCase() + result.level.slice(1));
+  ctx.font = '700 40px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
+  const pillPadX = 40, textW = ctx.measureText(levelLabel).width;
+  const pillW = textW + pillPadX * 2, pillH = 78, pillX = W / 2 - pillW / 2, pillY = 570;
+  iqRoundRectPath(ctx, pillX, pillY, pillW, pillH, pillH / 2);
+  ctx.fillStyle = 'rgba(255,255,255,.16)'; ctx.fill();
+  ctx.lineWidth = 2; ctx.strokeStyle = 'rgba(255,255,255,.6)'; ctx.stroke();
+  ctx.fillStyle = '#ffffff'; ctx.fillText(levelLabel, W / 2, pillY + pillH / 2 + 14);
+
+  const me = (window.Sky && Sky.db && Sky.db.me && Sky.db.me()) || null;
+  const userName = (me && me.name) || Sky.t('student');
+  const dateStr = new Intl.DateTimeFormat(Sky.lang === 'en' ? 'en-US' : 'ru-RU', {
+    day: 'numeric', month: 'long', year: 'numeric'
+  }).format(new Date());
+
+  ctx.font = '600 38px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
+  ctx.fillStyle = 'rgba(255,255,255,.95)'; ctx.fillText(userName, W / 2, 800);
+
+  ctx.font = '400 28px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
+  ctx.fillStyle = 'rgba(255,255,255,.7)'; ctx.fillText(dateStr, W / 2, 840);
+
+  ctx.font = '700 44px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
+  ctx.fillStyle = '#ffffff'; ctx.fillText(Sky.t('iqShareSlogan'), W / 2, 940);
+
+  await drawIqQrOrFallback(ctx, W, H);
+}
+
+function loadIqImage(src) {
+  return new Promise((resolve, reject) => {
+    const img = new Image();
+    img.crossOrigin = 'anonymous';
+    img.onload = () => resolve(img);
+    img.onerror = reject;
+    img.src = src;
+  });
+}
+
+async function drawIqQrOrFallback(ctx, W, H) {
+  const size = 150, x = W - size - 60, y = H - size - 60;
+  try {
+    const qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=0&data=' + encodeURIComponent(IQ_SHARE_URL);
+    const img = await loadIqImage(qrUrl);
+    ctx.fillStyle = '#ffffff';
+    iqRoundRectPath(ctx, x - 12, y - 12, size + 24, size + 24, 16); ctx.fill();
+    ctx.drawImage(img, x, y, size, size);
+    ctx.canvas.toDataURL(); /* проверка на "tainted canvas" из-за CORS — иначе узнали бы только при скачивании */
+  } catch (e) {
+    ctx.save();
+    ctx.fillStyle = 'rgba(255,255,255,.16)';
+    iqRoundRectPath(ctx, x - 12, y - 12, size + 24, size + 24, 16); ctx.fill();
+    ctx.fillStyle = '#ffffff';
+    ctx.font = '600 22px system-ui, sans-serif';
+    ctx.textAlign = 'center';
+    ctx.fillText('skyschool', x + size / 2, y + size / 2 - 4);
+    ctx.restore();
+  }
+}
+
+function downloadIqShareCanvas(canvas, result) {
+  try {
+    canvas.toBlob((blob) => {
+      if (!blob) return;
+      const url = URL.createObjectURL(blob);
+      const a = document.createElement('a');
+      a.href = url; a.download = `skyschool-iq-${result.percent}.png`;
+      document.body.appendChild(a); a.click(); a.remove();
+      setTimeout(() => URL.revokeObjectURL(url), 2000);
+    }, 'image/png');
+  } catch (e) {
+    Sky.toast(iqShareText(result));
+  }
+}
+
+async function iqNativeShare(canvas, result) {
+  try {
+    const blob = await new Promise((res) => canvas.toBlob(res, 'image/png'));
+    const file = new File([blob], 'skyschool-result.png', { type: 'image/png' });
+    if (navigator.canShare && navigator.canShare({ files: [file] })) {
+      await navigator.share({ files: [file], text: iqShareText(result) });
+      return;
+    }
+  } catch (e) { /* падаем в текстовый шаринг ниже */ }
+  try { await navigator.share({ text: iqShareText(result), url: IQ_SHARE_URL }); } catch (e) { /* пользователь отменил — ничего не делаем */ }
+}
+
